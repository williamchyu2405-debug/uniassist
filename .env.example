# Copy to .env for local dev. On Railway, set these as service Variables instead.

# Optional. Leave BLANK to run fully zero-API (guide quizzes still work from the
# saved banks). Set a real key only if you want live AI generation and have credits.
ANTHROPIC_API_KEY=

# Gate the whole app behind a passphrase. BLANK = no lock (fine for localhost).
# On any public deploy you MUST set this, or the app is wide open.
# The gallery at /guides stays public by design (shareable); everything else is gated.
ACCESS_CODE=

# Where the SQLite DB + uploads live. BLANK = ./data (local).
# On Railway set DATA_DIR=/data and mount a persistent Volume at /data.
DATA_DIR=
